# 다른 Firebase 프로젝트에 연결할 때만 .env.local 로 복사해 값을 채웁니다.
# 비워 두면 src/lib/firebase-config.js 의 기본값(dohyeon-da2f1)을 씁니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 레퍼런스가 들어 있는 Realtime Database 경로 / 서식이 들어 있는 Storage 폴더
VITE_REFERENCES_PATH=sheetsData/sheetsData
VITE_FORMS_FOLDER=forms
