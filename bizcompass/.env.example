# 다른 Firebase 프로젝트에 연결할 때만 .env.local 로 복사해 값을 채웁니다.
# 비워 두면 src/lib/firebase-config.js 의 기본값(dohyeon-da2f1)을 씁니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 레퍼런스가 들어 있는 Realtime Database 경로 / 서식이 들어 있는 Storage 폴더
VITE_REFERENCES_PATH=sheetsData/sheetsData
VITE_FORMS_FOLDER=forms

# 정부지원사업 공고 API (공공데이터포털 일반 인증키) — 서버에서만 읽습니다. VITE_ 접두사를 붙이지 마세요.
# 로컬에서는 .env.local 에, 배포 환경에서는 Vercel 프로젝트의 환경변수에 넣습니다.
DATA_GO_KR_SERVICE_KEY=

# 서식 파일을 읽는 서버 전용 Firebase 계정 — 서버에서만 읽습니다. VITE_ 접두사를 붙이지 마세요.
# Storage 보안 규칙(firebase/storage.rules)이 이 계정의 UID 만 읽기를 허용합니다.
FIREBASE_SERVICE_EMAIL=
FIREBASE_SERVICE_PASSWORD=
